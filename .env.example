# ---------------------------------------------------------------------------
# Firebase (CMS) configuration
# ---------------------------------------------------------------------------
# These values come from the Firebase Console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup (Config)
#
# They are PUBLIC by design. Access control is enforced by Firestore Security
# Rules + Firebase Auth (see firestore.rules), not by keeping these secret.
#
# Copy this file to `.env` for local dev, and add the same keys to your
# Vercel project (Settings -> Environment Variables) for production.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
